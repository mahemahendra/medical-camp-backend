# ─── Medical Camp Backend - GCP Production Environment ───
# Copy this to .env on the GCP VM:
#   cp .env.gcp.example .env && nano .env

# ── Server ──
NODE_ENV=production
PORT=3000

# ── Database (local PostgreSQL on same VM) ──
DATABASE_URL=postgresql://medcamp:medcamp_secure_pw_change_me@localhost:5432/medical_camp_db
# No SSL needed for localhost PostgreSQL
# DATABASE_SSL=true  # Uncomment only if using external managed DB

# ── JWT Secret (CHANGE THIS — generate with: openssl rand -hex 32) ──
JWT_SECRET=CHANGE_ME_GENERATE_SECURE_SECRET

# ── URLs ──
# Replace YOUR_VM_IP with your GCP VM's external IP address
BACKEND_URL=http://YOUR_VM_IP
FRONTEND_URL=http://YOUR_VM_IP

# ── File Storage ──
# Option A: Local disk (default — files stored in ./uploads, served by Nginx)
UPLOAD_DIR=./uploads
# GCS_BUCKET_NAME=          # Leave unset for local storage

# Option B: Google Cloud Storage (uncomment to enable)
# GCS_BUCKET_NAME=your-gcs-bucket-name
# (GCS auth is automatic on GCP VMs via service account)

# ── Telegram Bot (optional) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── WhatsApp API (placeholder) ──
WHATSAPP_API_KEY=
